{
  "name": "skillvault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/dev-db.mjs",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "bcryptjs": "2.4.3",
    "jose": "5.9.3",
    "jszip": "3.10.1",
    "marked": "12.0.2",
    "next": "15.5.29",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "yaml": "2.5.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "18.6.0-beta.19",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.45",
    "prisma": "5.19.1",
    "tailwindcss": "3.4.10",
    "tsx": "4.19.0",
    "typescript": "5.5.4"
  }
}
